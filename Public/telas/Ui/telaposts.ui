      <property name="styleSheet">
       <string notr="true">/* A borda da área de conteúdo das abas */
QTabWidget::pane { 
    border: 1px solid #444444;
    top: -1px; 
}

/* A barra onde ficam os botões das abas */
QTabBar::tab {
    background: #222222;
    color: white;
    border: 1px solid #444444;
    padding: 5px;
}

/* Quando a aba está selecionada */
QTabBar::tab:selected {
    background: #333333;
    border-bottom-color: #00FF00; /* Linha verde na aba ativa */
}</string>
